DISCORD_TOKEN=dein_discord_bot_token
CLIENT_ID=deine_discord_application_id
GUILD_ID=deine_discord_server_id

TRELLO_KEY=dein_trello_api_key
TRELLO_TOKEN=dein_trello_token

# Aus deinem Trello-Link:
# https://trello.com/b/VmxUfjSm/project-blackout-suggestions
# => VmxUfjSm
TRELLO_BOARD_SHORTLINK=VmxUfjSm

# Ziel-Liste auf deinem Board
TRELLO_TARGET_LIST_NAME=Suggestions

# Optional: Kanal-ID für Admin/Moderator-Logs
# In diesen Kanal sendet der Bot eine Nachricht, sobald eine neue Idee erstellt wurde.
LOG_CHANNEL_ID=deine_admin_oder_mod_log_kanal_id
