# ============================================================
# PROJECT BLACKOUT DISCORD BOT - ENVIRONMENT CONFIGURATION
# Copy this file to .env for local use.
# In Railway, create the same entries under Variables.
# Never publish your real DISCORD_TOKEN or Trello token.
# ============================================================


# =========================
# DISCORD BOT CONFIG
# =========================

DISCORD_TOKEN=PASTE_YOUR_DISCORD_BOT_TOKEN
CLIENT_ID=PASTE_YOUR_DISCORD_APPLICATION_ID
GUILD_ID=PASTE_YOUR_DISCORD_SERVER_ID

# Used for the bot activity and welcome messages.
SERVER_NAME=Project Blackout PVP


# =========================
# SERVER INFO PANEL LOCATION
# =========================

# Channel in which the server-info embed should be posted.
# When this ID is configured, the bot creates the panel automatically
# on the first start and saves the resulting message ID.
SERVER_INFO_CHANNEL_ID=PASTE_YOUR_SERVER_INFO_CHANNEL_ID

# Optional: only enter this when a server-info message already exists
# and that message was originally sent by this bot.
SERVER_INFO_MESSAGE_ID=


# =========================
# DAYZ SERVER INFORMATION
# =========================

# These values are used when server-info.json is created for the first time.
# Afterwards, you can change them directly in Discord with /serverinfo edit.
DAYZ_SERVER_NAME=Project Blackout PVP
DAYZ_SERVER_IP=208.115.251.67
DAYZ_SERVER_PORT=2491
DAYZ_SERVER_MAP=ChernarusPlus
DAYZ_SERVER_SLOTS=40
DAYZ_SERVER_PERSPECTIVE=First Person Only
DAYZ_MAX_GROUP_SIZE=4 Players
DAYZ_GROUP_SIZE_NOTE=The group limit includes all online and offline members. Alliances are not permitted.
DAYZ_SERVER_LANGUAGE=English
DAYZ_SERVER_PLATFORM=PC
DAYZ_RAID_TIMES=24/7
DAYZ_SERVER_REGION=Europe
DAYZ_SERVER_TIME_ZONE=Europe/Zurich

# Use 24-hour times separated by commas.
DAYZ_RESTART_TIMES=00:00,04:00,08:00,12:00,16:00,20:00

# Separate features with the | character. Maximum: 25 features.
DAYZ_SERVER_FEATURES=Fast-paced PVP economy|Safezone Traders|Full-PVP Black Market|King of the Hill events|Keycard Rooms|Hacked Crate events|Airdrops|Helicopters|Custom Vehicles|BaseBuildingPlus|Custom Weapons and Equipment|Custom Locations|24/7 Raiding|Maximum group size of four players|Active Administration


# =========================
# SERVER INFO CHANNEL LINKS
# =========================

# These four IDs are already filled in with your current channels.
SERVER_INFO_RULES_CHANNEL_ID=1479225004607406190
SERVER_INFO_SUPPORT_CHANNEL_ID=1479481269942226984
SERVER_INFO_TICKETS_CHANNEL_ID=1479479331393634404
SERVER_INFO_ANNOUNCEMENTS_CHANNEL_ID=1479495228527214724

# Add this after creating your server-status channel.
SERVER_INFO_STATUS_CHANNEL_ID=


# =========================
# TRELLO CONFIG
# =========================

TRELLO_KEY=PASTE_YOUR_TRELLO_API_KEY
TRELLO_TOKEN=PASTE_YOUR_TRELLO_API_TOKEN
TRELLO_BOARD_SHORTLINK=PASTE_YOUR_TRELLO_BOARD_SHORTLINK
TRELLO_TARGET_LIST_NAME=Suggestions
TRELLO_BOARD_URL=https://trello.com/


# =========================
# TRELLO PRIORITY LABELS
# =========================

TRELLO_HIGH_PRIORITY_LABEL_NAME=High Priority
TRELLO_MEDIUM_PRIORITY_LABEL_NAME=Medium Priority
TRELLO_HIGH_PRIORITY_LABEL_COLOR=red
TRELLO_MEDIUM_PRIORITY_LABEL_COLOR=yellow


# =========================
# DISCORD ROLE PRIORITY SYSTEM
# =========================

# Multiple role IDs can be separated according to your existing bot setup.
PRIORITY_HIGH_ROLE_IDS=
PRIORITY_MEDIUM_ROLE_IDS=


# =========================
# OTHER BOT CHANNELS
# =========================

LOG_CHANNEL_ID=PASTE_YOUR_SUGGESTION_LOG_CHANNEL_ID
WELCOME_CHANNEL_ID=PASTE_YOUR_WELCOME_CHANNEL_ID

# Used by the welcome-message rules button.
# This can be the same ID as SERVER_INFO_RULES_CHANNEL_ID.
SERVER_RULES_CHANNEL_ID=1479225004607406190

VERIFY_LOG_CHANNEL_ID=PASTE_YOUR_VERIFY_LOG_CHANNEL_ID


# =========================
# ROLES
# =========================

# VERIFY_ROLE_ID is used by the Verify button.
VERIFY_ROLE_ID=PASTE_YOUR_VERIFIED_ROLE_ID
UNVERIFIED_ROLE_ID=PASTE_YOUR_UNVERIFIED_ROLE_ID

# VERIFIED_ROLE_ID is used to trigger the welcome message after verification.
# Usually this should contain the same role ID as VERIFY_ROLE_ID.
VERIFIED_ROLE_ID=PASTE_YOUR_VERIFIED_ROLE_ID


# =========================
# OPTIONAL IMAGES
# =========================

WELCOME_IMAGE_URL=
VERIFY_IMAGE_URL=


# =========================
# DONATION SYSTEM
# =========================

DONATION_FORUM_CHANNEL_ID=PASTE_YOUR_DONATION_FORUM_CHANNEL_ID
DONATION_GOAL_AMOUNT=300
DONATION_CURRENCY_SYMBOL=€


# =========================
# RAILWAY / PERSISTENT STORAGE
# =========================

# Local default:
DATA_DIR=./data

# For Railway with a mounted Volume, change DATA_DIR to /data.
# This preserves the panel message ID, edited IP, rules and donation data.

# Railway provides PORT automatically. Do not set it manually.

# Optional connection monitoring values used by the existing bot.
DISCORD_READY_TIMEOUT_MS=90000
DISCORD_OFFLINE_RESTART_MS=300000
