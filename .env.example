# =========================
# DISCORD BOT CONFIG
# =========================

DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_bot_client_id_here
GUILD_ID=your_test_server_id_here

SERVER_NAME=Project Blackout PVP


# =========================
# TRELLO CONFIG
# =========================

TRELLO_KEY=your_trello_api_key
TRELLO_TOKEN=your_trello_api_token
TRELLO_BOARD_SHORTLINK=your_board_shortlink
TRELLO_TARGET_LIST_NAME=Suggestions
TRELLO_BOARD_URL=https://trello.com/


# =========================
# TRELLO PRIORITY LABELS
# =========================

# Must match your existing Trello labels EXACTLY
TRELLO_HIGH_PRIORITY_LABEL_NAME=High Priority
TRELLO_MEDIUM_PRIORITY_LABEL_NAME=Medium Priority

# Trello label colors (valid: green, yellow, orange, red, purple, blue, sky, lime, pink, black)
TRELLO_HIGH_PRIORITY_LABEL_COLOR=red
TRELLO_MEDIUM_PRIORITY_LABEL_COLOR=yellow


# =========================
# DISCORD ROLE PRIORITY SYSTEM
# =========================

# Comma separated role IDs
PRIORITY_HIGH_ROLE_IDS=123456789012345678
PRIORITY_MEDIUM_ROLE_IDS=987654321098765432


# =========================
# CHANNELS
# =========================

LOG_CHANNEL_ID=your_log_channel_id
WELCOME_CHANNEL_ID=your_welcome_channel_id
VERIFY_LOG_CHANNEL_ID=your_verify_log_channel_id


# =========================
# ROLES
# =========================

VERIFY_ROLE_ID=your_verified_role_id
UNVERIFIED_ROLE_ID=your_unverified_role_id


# =========================
# OPTIONAL IMAGES
# =========================

WELCOME_IMAGE_URL=https://your-image-link.png
VERIFY_IMAGE_URL=https://your-image-link.png

DONATION_FORUM_CHANNEL_ID=deine_forum_channel_id
DONATION_GOAL_AMOUNT=300
DONATION_CURRENCY_SYMBOL=€
